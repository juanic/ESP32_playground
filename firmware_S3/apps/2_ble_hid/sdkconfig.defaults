# Defaults applied by idf.py on reconfigure (all targets; this project is esp32s3-only).
# These are the source of truth; sdkconfig is regenerated from them.
#
# HID transport selection (drivers_hal/Kconfig)
CONFIG_HID_TRANSPORT_BLE=y

# Bluetooth (required by the BLE HID driver: esp_hid + Bluedroid host + controller)
# ESP-IDF v6.x notes:
#  - No CONFIG_BT_BLE_ENABLED symbol (BLE is implied by the host choice below)
#  - No CONFIG_BTDM_CTRL_MODE_BLE_ONLY symbol
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
# BLE 4.2 features (legacy advertising) are OFF by default on ESP32-S3 (only the
# original ESP32 defaults them on). Our driver uses legacy esp_ble_gap_config_adv_data/
# esp_ble_gap_start_advertising, so 4.2 features must be explicitly enabled.
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
