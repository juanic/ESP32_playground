CONFIG_IDF_TARGET="esp32"

# AI-Thinker ESP32-CAM: 4 MB flash and 4 MB PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Optional HALs used by this example
CONFIG_CAMERA_HAL_ENABLED=y
CONFIG_WIFI_HAL_ENABLED=y
CONFIG_SD_HAL_ENABLED=y

# AI-Thinker board uses an OV2640 sensor
CONFIG_OV2640_SUPPORT=y

# UXGA JPEGs can grow past the automatic width*height/5 estimate
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE_CUSTOM=y
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE=512000

# The web UI serves a few large buffers from the heap
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Keep the largest heap regions for the detection uploads
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Disable brownout detector to prevent resets caused by current spikes during Wi-Fi transmission
CONFIG_ESP_BROWNOUT_DET=n
