# Bluetooth Dual Mode (BLE control + Classic A2DP) via Bluedroid
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y

# Controller: Dual Mode so BR/EDR (Classic) + BLE coexist
CONFIG_BTDM_CTRL_MODE_BTDM=y

# Classic profiles
CONFIG_BT_A2DP_ENABLE=y

# BLE GATT Server (control channel)
CONFIG_BT_GATTS_ENABLE=y

# NVS
CONFIG_NVS_ENCRYPTION=n

# Partition table: use default with NVS
CONFIG_PARTITION_TABLE_DEFAULT=y

# Stack size for BT tasks
CONFIG_BT_BTU_TASK_STACK_SIZE=4096

# I2S
CONFIG_I2S_ISR_IRAM_SAFE=n
